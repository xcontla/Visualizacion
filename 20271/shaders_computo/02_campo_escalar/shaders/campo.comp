#version 430

// Grupos de 16x16 hilos: un hilo por texel
layout(local_size_x = 16, local_size_y = 16) in;

// La textura vista como imagen (unidad de imagen 0, ver glBindImageTexture)
layout(r32f, binding = 0) uniform writeonly image2D campo;

uniform vec2  centro1;   // calculados en la CPU con glm
uniform vec2  centro2;
uniform float tiempo;

float gaussiana(vec2 p, vec2 c, float sigma) {
    vec2 d = p - c;
    return exp(-dot(d, d) / (2.0 * sigma * sigma));
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 tam   = imageSize(campo);
    if (pixel.x >= tam.x || pixel.y >= tam.y) return;

    // Coordenadas del dominio en [-1, 1]
    vec2 p = (vec2(pixel) + 0.5) / vec2(tam) * 2.0 - 1.0;

    // Campo escalar: una "montaña" positiva, una negativa y una onda de fondo
    float f = gaussiana(p, centro1, 0.25)
            - gaussiana(p, centro2, 0.25)
            + 0.3 * sin(4.0 * p.x + tiempo) * cos(4.0 * p.y);

    imageStore(campo, pixel, vec4(f, 0.0, 0.0, 0.0));
}
