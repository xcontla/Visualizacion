#version 430

// Cada grupo de trabajo tiene 64 hilos (invocaciones) en x
layout(local_size_x = 64) in;

// Los "binding" coinciden con glBindBufferBase(..., binding, ...) en modelo.cpp
layout(std430, binding = 0) readonly  buffer Entrada { float a[];    };
layout(std430, binding = 1) writeonly buffer Salida  { float b[];    };
layout(std430, binding = 2) writeonly buffer Info    { uvec4 ids[];  };

uniform float escala;
uniform uint  n;

void main() {
    // Índice global de este hilo = gl_WorkGroupID * local_size + gl_LocalInvocationID
    uint i = gl_GlobalInvocationID.x;

    // Lanzamos grupos completos, así que puede haber hilos "de sobra"
    if (i >= n) return;

    b[i] = escala * a[i] * a[i];

    // Guardamos los índices para imprimirlos en la CPU
    ids[i] = uvec4(gl_GlobalInvocationID.x, gl_LocalInvocationID.x, gl_WorkGroupID.x, 0u);
}
